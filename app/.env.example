VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback if your project still uses an anon key name:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ENABLE_DEMO_AUTH=false
VITE_REPORTS_DATA_MODE=supabase

# Login demo lokal (opsional, hanya berlaku saat DEV + VITE_ENABLE_DEMO_AUTH=true).
# Biarkan kosong untuk mematikan jalur login demo sepenuhnya.
VITE_DEMO_ADMIN_EMAIL=admin@alirin.local
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_PETUGAS_EMAIL=petugas@alirin.local
VITE_DEMO_PETUGAS_PASSWORD=
